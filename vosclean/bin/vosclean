#!/bin/sh
# vosclean control script. Run with no arguments for usage.
VC=/data/vosclean
LOG=$VC/log/vosclean.log
CONF=$VC/etc/vosclean.conf
GOOD=$VC/etc/vosclean.conf.last-good
# Secure defaults first: an empty, missing or damaged settings file must never
# switch the hardening off (an unflushed rewrite once left it empty after a reset).
SSH_PASSWORD_AUTH=no FIREWALL_WWAN_BLOCK=yes DISABLE_FOTACLIENT=yes DISABLE_RPC_NFS=yes
PERSIST_HOSTKEYS=yes UI_ENABLE=no QM_ENABLE=yes QM_PORT=8080 QM_TLS_PORT=8443 QM_WATCHDOG=0
SSR_RELATED=yes SSR_RECOVER_SECS=180 HEARTBEAT_MINUTES=5 MODULES=""
conf_ok() { [ -s "$1" ] && grep -q '^[A-Z_][A-Z0-9_]*=' "$1" && sh -n "$1" 2>/dev/null; }
CONF_NOTE=""
if ! conf_ok $CONF; then
  if conf_ok $GOOD; then
    cp $GOOD $CONF.tmp && sync && mv $CONF.tmp $CONF && sync
    CONF_NOTE="etc/vosclean.conf was empty or damaged: restored the last good copy"
  else
    CONF_NOTE="etc/vosclean.conf is empty or damaged and there is no last good copy: using secure defaults"
  fi
fi
conf_ok $CONF && . $CONF
mkdir -p $VC/log
log() { echo "$(date -u '+%F %T') $*" >> $LOG; }
[ -n "$CONF_NOTE" ] && log "WARNING: $CONF_NOTE"
# remember a known-good copy of the settings (written only when they change)
conf_save_good() { conf_ok $CONF && ! cmp -s $CONF $GOOD && cp $CONF $GOOD.tmp && sync && mv $GOOD.tmp $GOOD && sync; return 0; }
# keep log small
[ -f $LOG ] && [ $(wc -c < $LOG) -gt 200000 ] && tail -c 100000 $LOG > $LOG.tmp && mv $LOG.tmp $LOG

is_bound() { grep -q " $1 " /proc/mounts; }

do_roothome() {
  [ -d $VC/roothome/.ssh ] || return 0
  chmod 755 $VC/roothome; chmod 700 $VC/roothome/.ssh
  [ -f $VC/roothome/.ssh/authorized_keys ] && chmod 600 $VC/roothome/.ssh/authorized_keys
  is_bound /home/root || { mount --bind $VC/roothome /home/root && log "roothome bound"; }
}

do_hostkeys() {
  [ "$PERSIST_HOSTKEYS" = yes ] || return 0
  mkdir -p $VC/hostkeys; chmod 700 $VC/hostkeys
  for t in ed25519 ecdsa rsa; do
    k=ssh_host_${t}_key
    if [ -s $VC/hostkeys/$k ]; then
      if ! cmp -s $VC/hostkeys/$k /var/run/ssh/$k; then
        mkdir -p /var/run/ssh; cp $VC/hostkeys/$k $VC/hostkeys/$k.pub /var/run/ssh/ && chmod 600 /var/run/ssh/$k && log "restored host key $t"
      fi
    elif [ -s /var/run/ssh/$k ]; then
      cp /var/run/ssh/$k /var/run/ssh/$k.pub $VC/hostkeys/ && chmod 600 $VC/hostkeys/$k && log "saved host key $t"
    fi
  done
}

do_sshd() {
  if [ "$SSH_PASSWORD_AUTH" = no ]; then pw=no; rl=prohibit-password; else pw=yes; rl=yes; fi
  # never disable passwords unless at least one key is authorised
  if [ "$pw" = no ] && ! grep -q '^ssh-' $VC/roothome/.ssh/authorized_keys 2>/dev/null; then
    pw=yes; rl=yes; log "SSH_PASSWORD_AUTH=no ignored: no authorised keys"
  fi
  sed -e "s/@PWAUTH@/$pw/" -e "s/@ROOTLOGIN@/$rl/" $VC/etc/sshd_config > /run/vosclean_sshd_config
  if /usr/sbin/sshd -t -f /run/vosclean_sshd_config 2>>$LOG; then
    is_bound /etc/ssh/sshd_config_readonly || mount --bind /run/vosclean_sshd_config /etc/ssh/sshd_config_readonly
    log "sshd config active (password=$pw)"
  else
    log "sshd config test FAILED; vendor config left in place"
  fi
}

fw_rules() { # $1 = iptables|ip6tables
  t=$1
  $t -N VOSCLEAN_IN 2>/dev/null || $t -F VOSCLEAN_IN
  $t -A VOSCLEAN_IN -i lo -j RETURN
  $t -A VOSCLEAN_IN -m state --state ESTABLISHED,RELATED -j RETURN
  [ $t = ip6tables ] && $t -A VOSCLEAN_IN -p 58 -j RETURN
  for i in 'rmnet+' 'ppp+'; do $t -A VOSCLEAN_IN -i "$i" -j DROP; done
  $t -A VOSCLEAN_IN -j RETURN
  $t -C INPUT -j VOSCLEAN_IN 2>/dev/null || $t -I INPUT 1 -j VOSCLEAN_IN
}
do_fw() {
  [ "$FIREWALL_WWAN_BLOCK" = yes ] || return 0
  fw_rules iptables && fw_rules ip6tables && log "firewall applied"
}
stop_fw() {
  for t in iptables ip6tables; do $t -D INPUT -j VOSCLEAN_IN 2>/dev/null; $t -F VOSCLEAN_IN 2>/dev/null; $t -X VOSCLEAN_IN 2>/dev/null; done
  log "firewall removed"
}
fw_watch() { # re-insert the jump if something (e.g. QCMAP) flushed INPUT
  [ "$FIREWALL_WWAN_BLOCK" = yes ] || return 0
  for t in iptables ip6tables; do $t -C INPUT -j VOSCLEAN_IN 2>/dev/null || { fw_rules $t; log "firewall re-applied ($t)"; }; done
}

do_fota() {
  [ "$DISABLE_FOTACLIENT" = yes ] || return 0
  systemctl stop fotaclient.timer 'fotaclient@-u.service' 2>/dev/null
  systemctl mask --runtime fotaclient.timer 'fotaclient@.service' fotaclient_init.service >/dev/null 2>&1
  chmod 755 $VC/stub/fotaclient
  is_bound /sbin/fotaclient || { mount --bind $VC/stub/fotaclient /sbin/fotaclient && log "fotaclient neutralised"; }
}

do_rpc() {
  [ "$DISABLE_RPC_NFS" = yes ] || return 0
  systemctl stop nfs-server.service nfs-mountd.service nfs-statd.service rpcbind.socket rpcbind.service 2>/dev/null
  systemctl mask --runtime rpcbind.socket rpcbind.service nfs-server.service nfs-mountd.service nfs-statd.service >/dev/null 2>&1
  log "rpcbind/nfs stopped"
}


do_bandsave() { # remember factory band preferences once (used by "Restore defaults")
  mkdir -p $VC/state
  [ -s $VC/state/bands.default ] && return 0
  out=$(timeout -t 12 cricli get_pref_band 2>/dev/null) || return 0
  echo "$out" | awk '
    /^LTE Band Pref/ {s="2"} /^NR5G NSA Band Pref/ {s="3"} /^NR5G SA Band Pref/ {s="4"} /^Band Pref/ {s=""}
    /0x[0-9A-Fa-f]+/ && s!="" { match($0,/0x[0-9A-Fa-f]+/); w[s]=w[s] " " substr($0,RSTART,RLENGTH) }
    END { for (k in w) print k w[k] }' | sort > $VC/state/bands.default.tmp
  if [ $(grep -c . $VC/state/bands.default.tmp) -eq 3 ]; then mv $VC/state/bands.default.tmp $VC/state/bands.default; log "saved factory band preferences"; else rm -f $VC/state/bands.default.tmp; fi
}

do_uicert() { # self-signed cert with explicit dates (the modem clock may read 1970)
  [ -s $VC/etc/ui.pem ] && return 0
  d=$(mktemp -d); mkdir -p $d/newcerts; : > $d/index.txt; echo 01 > $d/serial
  cat > $d/ca.cnf <<CNF
[ca]
default_ca=c
[c]
dir=$d
database=$d/index.txt
new_certs_dir=$d/newcerts
serial=$d/serial
default_md=sha256
policy=p
unique_subject=no
copy_extensions=copy
[p]
commonName=supplied
[req]
distinguished_name=dn
prompt=no
req_extensions=ext
[dn]
CN=vos.local
[ext]
subjectAltName=IP:192.168.225.1,DNS:vos.local,DNS:mobileap.qualcomm.com
basicConstraints=CA:FALSE
keyUsage=digitalSignature,keyEncipherment
extendedKeyUsage=serverAuth
CNF
  openssl req -new -newkey rsa:2048 -nodes -keyout $d/key.pem -out $d/req.pem -config $d/ca.cnf 2>>$LOG &&
  openssl ca -batch -selfsign -config $d/ca.cnf -keyfile $d/key.pem -in $d/req.pem -out $d/crt.pem -startdate 20261001000000Z -enddate 20361001000000Z -extensions ext -extfile $d/ca.cnf -notext 2>>$LOG &&
  cat $d/key.pem $d/crt.pem > $VC/etc/ui.pem && chmod 600 $VC/etc/ui.pem && log "web UI certificate created"
  rm -rf $d
}

do_ui() {
  [ "$UI_ENABLE" = yes ] || return 0
  do_uicert
  [ -s $VC/etc/ui.htpasswd ] || { log "web UI not started: run 'vosclean uipass' first"; return 0; }
  chmod 755 $VC/web/cgi-bin/api.sh; chmod 600 $VC/etc/ui.htpasswd
  systemctl is-active --quiet vosclean-ui && return 0
  systemd-run --unit=vosclean-ui -p Restart=always -p RestartSec=10 /usr/sbin/lighttpd -D -f $VC/etc/lighttpd-ui.conf >/dev/null 2>&1 && log "web UI started on https://192.168.225.1:8444"
}

ui_pass() {
  printf "New web UI password for user 'admin': "; stty -echo 2>/dev/null; read -r p1; stty echo 2>/dev/null; echo
  printf "Repeat: "; stty -echo 2>/dev/null; read -r p2; stty echo 2>/dev/null; echo
  [ "$p1" = "$p2" ] || { echo "Passwords differ"; exit 1; }
  [ ${#p1} -ge 10 ] || { echo "Use at least 10 characters"; exit 1; }
  h=$(printf '%s' "$p1" | openssl passwd -apr1 -stdin) || exit 1
  echo "admin:$h" > $VC/etc/ui.htpasswd; chmod 600 $VC/etc/ui.htpasswd
  log "web UI password set"; echo "Saved."; do_ui
}

# The modem has no battery-backed clock and boots at 1970. Take UTC time from
# the mobile network (NITZ) if it sends one; not every network does, and only
# at registration, so fall back to NTP over the data connection. Runs at
# apply and from the per-minute watch until the clock is set.
TIME_NTP=${TIME_NTP:-"pool.ntp.org time.google.com time.cloudflare.com"}
do_time() {
  [ "$(date -u +%Y)" -ge 2025 ] && return 0
  t=$(timeout -t 10 cricli get_nitz 2>/dev/null | sed -n 's/^\([0-9]\{4\}-[0-9][0-9]-[0-9][0-9] [0-9:]\{8\}\).*/\1/p' | head -1)
  if [ -n "$t" ] && date -u -s "$t" >/dev/null 2>&1; then log "clock set from network time: $t UTC"; return 0; fi
  timeout -t 10 cricli wwan_status 2>/dev/null | grep -q 'IPV4: CONNECTED' || return 0
  for h in $TIME_NTP; do
    if timeout -t 15 ntpd -n -q -p "$h" >/dev/null 2>&1 && [ "$(date -u +%Y)" -ge 2025 ]; then
      log "clock set from NTP ($h): $(date -u '+%F %T') UTC"; return 0
    fi
  done
}

do_qm() {
  [ "$QM_ENABLE" = yes ] || return 0
  Q=$VC/qm; [ -x $Q/bin/qmanager-core ] && [ -x $Q/bin/qcmd ] || { log "QManager not installed"; return 0; }
  mkdir -p $Q/etc
  if [ ! -x $Q/bin/sms_tool ]; then printf '#!/bin/sh\nexec %s/bin/qcmd sms_tool "$@"\n' $Q > $Q/bin/sms_tool; chmod 755 $Q/bin/sms_tool; fi
  systemctl is-active --quiet qmanager && return 0
  mkdir -p /tmp/vosclean/log; L=/tmp/vosclean/log/qmanager.log   # RAM; tail saved to log/last-boot on shutdown
  systemd-run --unit=qmanager -p Restart=always -p RestartSec=10 -p MemoryMax=80M \
    --setenv=PATH=$Q/bin:/usr/sbin:/usr/bin:/sbin:/bin --setenv=PORT=${QM_PORT:-8080} --setenv=TLS_PORT=${QM_TLS_PORT:-8443} \
    --setenv=QM_WATCHDOG=${QM_WATCHDOG:-0} --setenv=HOME=$Q /bin/sh -c "exec $Q/bin/qmanager-core >> $L 2>&1" >/dev/null 2>&1 \
    && log "QManager started (http ${QM_PORT:-8080}, https ${QM_TLS_PORT:-8443})"
}

do_ts() { # Tailscale (installed from QManager's VPN page) - start on boot if enabled there
  T=$VC/tailscale
  [ -f $T/ENABLED_ON_BOOT ] && [ -x $T/bin/tailscaled ] || return 0
  if wg_cgnat; then log "Tailscale not started: the active WireGuard config uses 100.64.0.0/10"; return 0; fi
  systemctl is-active --quiet tailscaled && return 0
  mkdir -p $T/state /var/run/tailscale; systemctl reset-failed tailscaled 2>/dev/null
  systemd-run --unit=tailscaled -p Restart=on-failure -p RestartSec=10 -p MemoryMax=90M --setenv=GOGC=200 --setenv=GOMEMLIMIT=60MiB --setenv=HOME=$T \
    $T/bin/tailscaled --state=$T/state/tailscaled.state --statedir=$T/state --socket=/var/run/tailscale/tailscaled.sock \
    --port=41641 --no-logs-no-support >/dev/null 2>&1 && log "tailscaled started"
  sleep 3; ts_fw
}

ts_fw() { # NAT + MSS clamping so devices behind the stick can use accepted Tailscale subnet routes
  if systemctl is-active --quiet tailscaled; then
    iptables -t nat -C POSTROUTING -o tailscale0 -j MASQUERADE 2>/dev/null || iptables -t nat -I POSTROUTING 1 -o tailscale0 -j MASQUERADE
    for d in -o -i; do
      iptables -t mangle -C FORWARD $d tailscale0 -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu 2>/dev/null ||
        iptables -t mangle -A FORWARD $d tailscale0 -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu
    done
  else
    iptables -t nat -D POSTROUTING -o tailscale0 -j MASQUERADE 2>/dev/null
    for d in -o -i; do iptables -t mangle -D FORWARD $d tailscale0 -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu 2>/dev/null; done
  fi
  return 0
}

do_nb() { # NetBird (installed from QManager's VPN page) - start on boot if enabled there
  N=$VC/netbird
  [ -f $N/ENABLED_ON_BOOT ] && [ -x $N/bin/netbird ] || return 0
  if [ -s $WG/ACTIVE ]; then log "NetBird not started: a WireGuard config is active"; return 0; fi
  systemctl is-active --quiet netbird && return 0
  mkdir -p $N/state /tmp/vosclean/log; systemctl reset-failed netbird 2>/dev/null
  systemd-run --unit=netbird -p Restart=on-failure -p RestartSec=10 -p MemoryMax=90M \
    --setenv=NB_STATE_DIR=$N/state --setenv=GOMEMLIMIT=60MiB --setenv=HOME=$N --setenv=NB_LOG_MAX_SIZE_MB=1 \
    $N/bin/netbird service run --config $N/state/config.json --log-file /tmp/vosclean/log/netbird.log --log-level info \
    >/dev/null 2>&1 && log "netbird started"
  sleep 3; nb_fw
}

nb_fw() { # NAT + MSS clamping so devices behind the stick can use NetBird routes (same as ts_fw)
  if systemctl is-active --quiet netbird && ip link show wt0 >/dev/null 2>&1; then
    iptables -t nat -C POSTROUTING -o wt0 -j MASQUERADE 2>/dev/null || iptables -t nat -I POSTROUTING 1 -o wt0 -j MASQUERADE
    for d in -o -i; do
      iptables -t mangle -C FORWARD $d wt0 -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu 2>/dev/null ||
        iptables -t mangle -A FORWARD $d wt0 -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu
    done
  else
    iptables -t nat -D POSTROUTING -o wt0 -j MASQUERADE 2>/dev/null
    for d in -o -i; do iptables -t mangle -D FORWARD $d wt0 -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu 2>/dev/null; done
  fi
  return 0
}

# --- WireGuard VPN client (configs and the connect switch are on QManager's WireGuard page) ---
# The tunnel runs as its own unit (vos-wg) from the QManager binary, so restarting
# QManager doesn't drop it. $WG/ACTIVE names the config to keep connected, at boot too.
# The service sets up and repairs its own routes, NAT and firewall rules.
WG=$VC/wireguard
wg_start() { # wg_start [boot]: (re)start the tunnel for the active config
  [ -x $VC/qm/bin/qmanager-core ] || { echo "QManager isn't installed"; return 1; }
  if [ ! -s $WG/ACTIVE ]; then [ "$1" = boot ] && return 0; echo "no WireGuard config is active"; return 1; fi
  systemctl stop vos-wg 2>/dev/null; systemctl reset-failed vos-wg 2>/dev/null
  mkdir -p /tmp/vosclean/log
  systemd-run --unit=vos-wg -p Restart=on-failure -p RestartSec=15 -p MemoryMax=48M \
    --setenv=GOMEMLIMIT=32MiB --setenv=PATH=/usr/sbin:/usr/bin:/sbin:/bin \
    $VC/qm/bin/qmanager-core wg-run >/dev/null 2>&1 || { log "WireGuard: couldn't start the tunnel service"; echo "systemd-run failed"; return 1; }
  log "WireGuard: tunnel service started for $(head -c 40 $WG/ACTIVE)"
}
wg_stop() {
  systemctl stop vos-wg 2>/dev/null; systemctl reset-failed vos-wg 2>/dev/null
  [ -x $VC/qm/bin/qmanager-core ] && $VC/qm/bin/qmanager-core wg-cleanup >/dev/null 2>&1
  log "WireGuard: tunnel service stopped"
  return 0
}
do_wg() { systemctl is-active --quiet vos-wg && return 0; wg_start boot; }
wg_cgnat() { # the active WireGuard config uses 100.64.0.0/10, Tailscale's and NetBird's range
  [ -s $WG/ACTIVE ] || return 1
  f="$WG/configs/$(head -n1 $WG/ACTIVE).conf"
  [ -f "$f" ] && grep -iE '^[[:space:]]*(Address|DNS)[[:space:]]*=' "$f" | grep -qE '(^|[^0-9])100\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\.'
}
wg_status() {
  if [ -s $WG/ACTIVE ]; then echo "wireguard: $(systemctl is-active vos-wg 2>/dev/null) (config $(head -c 40 $WG/ACTIVE))"
  else echo "wireguard: off ($(ls $WG/configs/*.conf 2>/dev/null | wc -l) saved configs)"; fi
}

# --- modem crash handling ----------------------------------------------------------
# The firmware ships restart_level=SYSTEM: any baseband crash resets the whole SoC.
# With RELATED only the modem restarts (about 30 s without data) and Linux stays up.
# The watch loop records each crash on flash and, if mobile data has not come back
# within SSR_RECOVER_SECS, falls back to a clean full reboot.
SSR_COUNT=${VOS_SSR_STATE:-/tmp}/vosclean-ssr.count
SSR_PENDING=${VOS_SSR_STATE:-/tmp}/vosclean-ssr.pending
SSR_LOG=${VOS_SSR_LOG:-$VC/log/modem-crashes.log}
ssr_dev() {
  [ -n "$VOS_SSR_DEV" ] && { echo "$VOS_SSR_DEV"; return; }   # test hook
  for d in /sys/bus/msm_subsys/devices/*; do [ "$(cat $d/name 2>/dev/null)" = modem ] && { echo $d; return; }; done
}
ssr_log() { echo "$(date -u '+%F %T') $*" >> $SSR_LOG; log "$*"; }
data_up() {
  [ -n "$VOS_SSR_DATA" ] && { [ "$VOS_SSR_DATA" = up ]; return; }   # test hook
  timeout -t 10 cricli wwan_status 2>/dev/null | grep -q 'IPV4: CONNECTED'
}
do_ssr() {
  d=$(ssr_dev); [ -n "$d" ] || return 0
  if [ "${SSR_RELATED:-yes}" = yes ]; then want=RELATED; else want=SYSTEM; fi
  if [ "$(cat $d/restart_level)" != $want ]; then echo $want > $d/restart_level && log "modem restart_level=$want"; fi
  [ -s $SSR_COUNT ] || cat $d/crash_count > $SSR_COUNT
}
ssr_watch() {
  [ "${SSR_RELATED:-yes}" = yes ] || return 0
  d=$(ssr_dev); [ -n "$d" ] || return 0
  now=$(cut -d. -f1 /proc/uptime)
  c=$(cat $d/crash_count 2>/dev/null); prev=$(cat $SSR_COUNT 2>/dev/null)
  case "$c$prev" in *[!0-9]*|'') do_ssr; return 0 ;; esac
  if [ "$c" -gt "$prev" ]; then
    echo $c > $SSR_COUNT; echo $now > $SSR_PENDING
    ssr_log "modem crashed (crash count $prev -> $c, state $(cat $d/state 2>/dev/null)); restarting the radio only"
    dmesg 2>/dev/null | grep -i -E 'subsys-restart|subsystem_restart|subsys-pil|failure reason|err_fatal|\bssr\b|mss|q6v5|modem.*(crash|fail|down|up)' | tail -n 30 | sed 's/^/    /' >> $SSR_LOG
  fi
  [ -f $SSR_PENDING ] || return 0
  t0=$(cat $SSR_PENDING)
  if data_up; then
    ssr_log "mobile data back $((now - t0)) s after the modem crash"; rm -f $SSR_PENDING
  elif [ $((now - t0)) -ge ${SSR_RECOVER_SECS:-180} ]; then
    rm -f $SSR_PENDING
    if timeout -t 10 cricli op_mode 2>/dev/null | grep -q -i 'online' || [ -n "$VOS_SSR_DEV" ]; then
      ssr_log "mobile data still down $((now - t0)) s after the modem crash: rebooting"
      [ -n "$VOS_SSR_DEV" ] && { echo "TEST: would reboot now"; return 0; }
      sync; reboot
    else
      ssr_log "mobile data down after the modem crash, but the radio is switched off: not rebooting"
    fi
  fi
  [ -f $SSR_LOG ] && [ $(wc -c < $SSR_LOG) -gt 100000 ] && tail -c 50000 $SSR_LOG > $SSR_LOG.tmp && mv $SSR_LOG.tmp $SSR_LOG
  return 0
}

ram_logs() { # cap the RAM logs (they are appended to by long-running processes)
  for f in /tmp/vosclean/log/*.log; do
    [ -f "$f" ] && [ $(wc -c < "$f") -gt 524288 ] && { tail -c 262144 "$f" > "$f.tmp" && cat "$f.tmp" > "$f"; rm -f "$f.tmp"; }
  done
  return 0
}

qm_pass() { # QManager login password (stored as sha256(salt+password), QManager's own scheme)
  printf "New QManager password: "; stty -echo 2>/dev/null; read -r p1; stty echo 2>/dev/null; echo
  printf "Repeat: "; stty -echo 2>/dev/null; read -r p2; stty echo 2>/dev/null; echo
  [ "$p1" = "$p2" ] || { echo "Passwords differ"; exit 1; }
  [ ${#p1} -ge 10 ] || { echo "Use at least 10 characters"; exit 1; }
  salt=$(head -c 16 /dev/urandom | od -An -tx1 | tr -d ' \n')
  hash=$(printf '%s%s' "$salt" "$p1" | sha256sum | cut -d' ' -f1)
  mkdir -p $VC/qm/etc
  printf '{"salt":"%s","hash":"%s"}\n' "$salt" "$hash" > $VC/qm/etc/auth.json.tmp && chmod 600 $VC/qm/etc/auth.json.tmp && mv $VC/qm/etc/auth.json.tmp $VC/qm/etc/auth.json
  log "QManager password set"; echo "Saved. The default password 'admin' no longer works."
}

status() {
  echo "enabled: $([ -f $VC/ENABLED ] && echo yes || echo no)"
  echo "roothome bound: $(is_bound /home/root && echo yes || echo no)"
  echo "sshd config bound: $(is_bound /etc/ssh/sshd_config_readonly && echo yes || echo no) ($(grep -E '^PasswordAuthentication' /etc/ssh/sshd_config_readonly))"
  echo "fotaclient neutralised: $(is_bound /sbin/fotaclient && echo yes || echo no)"
  echo "rpcbind: $(systemctl is-active rpcbind.socket 2>/dev/null)/$(systemctl is-active rpcbind.service 2>/dev/null)"
  echo "web UI: $(systemctl is-active vosclean-ui 2>/dev/null) ($([ -s $VC/etc/ui.htpasswd ] && echo password set || echo no password yet))"
  echo "QManager: $(systemctl is-active qmanager 2>/dev/null) ($([ -s $VC/qm/etc/auth.json ] && echo password set || echo 'DEFAULT PASSWORD admin - run vosclean qmpass')) (ports ${QM_PORT:-8080}/${QM_TLS_PORT:-8443}, watchdog ${QM_WATCHDOG:-0})"
  echo "clock: $(date -u '+%F %T') UTC"
  echo "firewall v4: $(iptables -C INPUT -j VOSCLEAN_IN 2>/dev/null && echo on || echo off), v6: $(ip6tables -C INPUT -j VOSCLEAN_IN 2>/dev/null && echo on || echo off)"
  echo "tailscale: $(systemctl is-active tailscaled 2>/dev/null) ($([ -x $VC/tailscale/bin/tailscale ] && echo installed || echo not installed), boot $([ -f $VC/tailscale/ENABLED_ON_BOOT ] && echo on || echo off))"
  echo "netbird: $(systemctl is-active netbird 2>/dev/null) ($([ -x $VC/netbird/bin/netbird ] && echo installed || echo not installed), boot $([ -f $VC/netbird/ENABLED_ON_BOOT ] && echo on || echo off))"
  d=$(ssr_dev); [ -n "$d" ] && echo "modem crash handling: restart_level=$(cat $d/restart_level), crashes this boot: $(cat $d/crash_count)$([ -f $SSR_PENDING ] && echo ', waiting for data to return')"
  type modules_status >/dev/null 2>&1 && modules_status
  wg_status
  echo "custom DNS: $(iptables -t nat -C OUTPUT -j VOS_DNS 2>/dev/null && echo "on ($(. $VC/etc/dns.conf; echo $DNS_SERVERS))" || echo "off (operator DNS)")"
}

[ -f $VC/bin/dns.sh ] && . $VC/bin/dns.sh
[ -f $VC/bin/modules.sh ] && . $VC/bin/modules.sh

case "$1" in
  apply)   do_ssr; do_roothome; do_hostkeys; do_sshd; do_fw; do_fota; do_rpc; do_bandsave; do_ui; do_time; do_qm; do_dns; do_modules; do_ts; do_nb; do_wg; conf_save_good ;;
  uipass)  ui_pass ;;
  ui)      do_ui ;;
  qm)      do_time; do_qm ;;
  qmpass)  qm_pass ;;
  watch)   do_time; fw_watch; dns_watch; ts_fw; nb_fw; ssr_watch; ram_logs ;;
  dns)     do_dns ;;
  tsfw)    ts_fw ;;
  ssr)     do_ssr ;;
  modules) do_modules manual; conf_save_good; modules_status ;;
  modules-list) modules_list ;;
  wg)      case "$2" in start) wg_start ;; stop) wg_stop ;; *) wg_status ;; esac ;;
  status)  status ;;
  fw)      do_fw ;;
  stop-fw) stop_fw ;;
  *) echo "usage: vosclean {apply|status|qmpass|qm|uipass|ui|fw|stop-fw|watch|dns|tsfw|ssr|modules|modules-list|wg [start|stop]}"; exit 1 ;;
esac
